```python
import random


def simuler_jeu(nb_parties=10000):
  gains = []
  for _ in range(nb_parties):
    de = random.randint(1, 6)
    if de in [2, 4, 6]:
      gain = 1  # 3 - 2
    elif de == 5:
      gain = 4  # 6 - 2
    else:
      gain = -2  # 0 - 2
    gains.append(gain)
  moyenne = sum(gains) / nb_parties
  print(f"Moyenne simulée : {moyenne:.4f} € (Théorie : 0.5000 €)")


simuler_jeu()
